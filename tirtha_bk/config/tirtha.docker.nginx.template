# TEMPLATE -- rendered by build/build.sh with envsubst from build/tirtha.env.
# Do not edit the rendered copy in /etc/nginx/sites-available; edit this and
# re-run the build. Paths come from TIRTHA_ROOT / PROD_DIR / ERRORS_DIR so a
# second deployment (beta) needs only a different root (internal design notes).
# NOTE: Place this file in /etc/nginx/sites-available/ and symlink to /etc/nginx/sites-enabled/ after editing
server {
    listen 80;
    server_name localhost; # CHANGEME:

    location /static {
        alias ${PROD_DIR}static; # CHANGEME:
        autoindex off;
    }

    location /media {
        alias ${PROD_DIR}media; # CHANGEME:
        autoindex off;
    }

    location /403.html {
	alias ${ERRORS_DIR}/403.html; # CHANGEME:
    }
    error_page 403             /403.html;

    location /404.html {
        alias ${ERRORS_DIR}/404.html; # CHANGEME:
    }
    error_page 404             /404.html;

    location /500.html {
        alias ${ERRORS_DIR}/500.html; # CHANGEME:
    }
    error_page 500             /500.html;

    location / {
        include proxy_params;
        proxy_pass http://unix:/run/tirthad.sock; # CHANGEME: 
    }

    return 301 https://$server_name$request_uri;
}
